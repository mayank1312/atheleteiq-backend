# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/database

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY="replace-with-a-long-random-secret"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Storage (S3-compatible; MinIO locally, S3/GCS in prod) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# --- LLM ---
ADMIN_API_KEY="replace-with-a-random-admin-key"
OPENAI_API_KEY="replace-with-your-openai-api-key"

# --- Temporary test phase ---
# Self-uploads use the dominant tracked person instead of face matching and
# are not limited by the subscription upload quota.
TEST_PHASE_BYPASS_FACE_MATCHING=false
TEST_PHASE_UNLIMITED_UPLOADS=false
